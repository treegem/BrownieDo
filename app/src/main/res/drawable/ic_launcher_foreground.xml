<?xml version="1.0" encoding="utf-8"?>
<!-- Das Häufchen mit grünem Haken. Alles liegt innerhalb der zentralen 72x72-Sicherheitszone der
     108x108-Leinwand, damit keine Launcher-Maske etwas abschneidet. Das Häufchen ist heller als
     der Hintergrund aus ic_launcher_background.xml — gleiches Braun auf Braun wäre unsichtbar.
     Der Haken bekommt eine cremefarbene Kontur, damit er sich auch dort abhebt, wo er über dem
     Häufchen liegt. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Drei Windungen von unten nach oben, die unterste am breitesten. -->
    <path
        android:fillColor="#C89A6B"
        android:pathData="M30,80 C26,71 34,62 54,62 C74,62 82,71 78,80 C62,82.5 46,82.5 30,80 Z" />
    <path
        android:fillColor="#C89A6B"
        android:pathData="M37,64 C34,56 40,48.5 54,48.5 C68,48.5 74,56 71,64 C60,66 48,66 37,64 Z" />
    <path
        android:fillColor="#C89A6B"
        android:pathData="M44,51 C42,43 45,35 54,32 C63,35 66,43 64,51 C57,52.5 51,52.5 44,51 Z" />

    <!-- Augen. -->
    <path
        android:fillColor="#F5E6D3"
        android:pathData="M46,43 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0 Z" />
    <path
        android:fillColor="#F5E6D3"
        android:pathData="M57,43 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0 Z" />

    <!-- Der Haken. -->
    <path
        android:fillColor="#7CB342"
        android:pathData="M40,60 L35,65 L49,78 L75,50 L70,45 L49,68 Z"
        android:strokeColor="#F5E6D3"
        android:strokeLineJoin="round"
        android:strokeWidth="3" />
</vector>
